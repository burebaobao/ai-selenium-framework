```mermaid
flowchart TD
    Start(["用户请求元素<br/>GetElement()"])

    Start --> Check{是否有显式<br/>定位器?}

    Check -->|"有"| Try["尝试传统定位<br/>driver.find_element()"]
    Check -->|"无"| AIStart["直接进入<br/>AI定位流程"]

    Try --> Result{定位<br/>成功?}

    Result -->|"✓ 是"| Cache["缓存WebElement<br/>返回给调用方"]

    Result -->|"✗ 否"| AIStart

    AIStart --> A1["1. 获取页面HTML<br/>清理后发送"]

    A1 --> A2["2. 构建Prompt<br/>元素描述+页面结构"]
    A2 --> A3["3. 发送给LLM<br/>Claude/GPT/本地模型"]
    A3 --> A4["4. 解析JSON<br/>locator_type/value/confidence"]
    A4 --> Decision{confidence<br/>≥ 0.85?}

    Decision -->|"✓ 是 高置信度"| A5["5a. 缓存新定位器<br/>写入elements.yaml"]
    Decision -->|"✗ 否 低置信度"| A6["5b. 记录healing_log<br/>标记待人工审核"]

    A5 --> Retry["使用新定位器<br/>重试find_element()"]
    A6 --> Retry
    A5 -.->|"写持久化"| Repo["元素仓库<br/>elements.yaml"]
    A6 -.->|"仅记录"| Log["healing_log.jsonl<br/>待审阅"]

    Retry --> RetryOK{重试<br/>成功?}
    RetryOK -->|"✓"| Return(["返回元素 ✓"])
    RetryOK -->|"✗"| Error(["抛出异常<br/>ElementNotFoundError"])

